{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "coupon",
  "main": "src/index.tsx",
  "compatibility_date": "2026-09-01",
  "observability": { "enabled": true },
  // 只透過自訂網域提供服務，不開 *.workers.dev 入口
  "workers_dev": false,
  "preview_urls": false,

  // public/ 內的 CSS、JS 由 Cloudflare 直接提供，不經過 Worker
  "assets": { "directory": "./public" },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "coupon",
      // 執行 `npm run db:create` 後，把輸出的 database_id 貼到這裡
      "database_id": "7e7faea8-c4e2-4ec3-99d7-5aa9f0e658d4",
      "migrations_dir": "migrations"
    }
  ],

  "vars": {
    // Zero Trust 團隊網域，例如 "mycompany.cloudflareaccess.com"
    "ACCESS_TEAM_DOMAIN": "zuzoo.cloudflareaccess.com",
    // Access 應用程式的 Application Audience (AUD) Tag
    "ACCESS_AUD": "9ed11ed593bc113bc976a21954fee4998d3aaaaec6a4386918222cfb97e01f54",
    // 憑證的 iss。這個團隊最初叫 ancient-shadow-1fa4，之後改名（zuzoo-coupon-gen → zuzoo）iss 都沒有跟著變。
    // 程式同時接受 ACCESS_ISSUER 與 https://<ACCESS_TEAM_DOMAIN> 兩者。
    "ACCESS_ISSUER": "https://ancient-shadow-1fa4.cloudflareaccess.com"
  }

  // 自訂網域（網域需先託管在 Cloudflare）。
  // `wrangler deploy` 會讓 Worker 的自訂網域與這份清單完全一致：
  // 只在控制台加、沒寫在這裡的網域，下次部署會被移除（連同 DNS 記錄）。
  ,"routes": [{ "pattern": "coupon.zuzoo.tw", "custom_domain": true }]
}
